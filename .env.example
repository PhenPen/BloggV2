# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed.

# --- Runtime behavior (all optional; defaults shown) ---
# Verbosity of the app logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Comma-separated Host-header allowlist. Must include your public domain in
# production or every request gets rejected (DNS-rebinding protection).
ALLOWED_HOSTS=localhost,127.0.0.1

# Brute-force ceilings (per IP + account, per minute).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESET_PER_MINUTE=5

# --- Auth cookie + CSRF ---
# httpOnly JWT cookie. Secure MUST be true in production (HTTPS-only cookie).
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Header the frontend must send on cookie-authenticated writes.
CSRF_HEADER=x-csrf-protected
CSRF_HEADER_VALUE=1

# --- Database (PostgreSQL) ---
# The app builds this connection string:
#   postgresql+psycopg://{DB_USER}:{DB_PASSWORD}@{DB_HOST}/{DB_NAME}
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_NAME=fastapi_blog

# --- JWT auth ---
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string

# --- SMTP ---
# Dev: use a Mailtrap sandbox. Prod: your provider's SMTP settings.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=smtp-username
MAIL_PASSWORD=smtp-password
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# --- Frontend base URL ---
# Used to build password-reset links (must be the public site origin in prod).
FRONTEND_URL=http://localhost:8000

# --- AWS S3 ---
# Dev: leave keys empty and set AWS_ENDPOINT_URL to the local moto server.
# Prod: real IAM user keys (least-privilege, S3-only) and NO AWS_ENDPOINT_URL.
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Local dev only: http://127.0.0.1:5000
AWS_ENDPOINT_URL=
# How long a pre-signed image URL stays valid (seconds).
AWS_PRESIGN_EXPIRY_SECONDS=900